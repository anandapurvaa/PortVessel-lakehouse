# Python / Virtual Environments
.venv/
.env
__pycache__/
.pytest_cache/
.ruff_cache/

# Data Directories (keep structure with .gitkeep)
data/raw/*
data/extracted/*
data/processed/*
data/quarantine/*
data/warehouse/*
reports/*.json

!data/raw/.gitkeep
!data/extracted/.gitkeep
!data/processed/.gitkeep
!data/quarantine/.gitkeep
!data/warehouse/.gitkeep

# Local Databases & DuckDB files
data/local/*.duckdb
data/local/*.duckdb.wal
*.duckdb
*.duckdb.wal

# Terraform (matches .terraform folders anywhere in the repo)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
.tfstate.backup

# OS Specific Files
.DS_Store
Thumbs.db