        st_ymax(safe.st_geogfromtext(geometry_wkt)) as max_latitude,
        geometry_source,
        geometry_version,
        effective_from,
        effective_to,
        is_active
    from source_geofences

)

select * from final
where zone_geography is not null
    );
  
