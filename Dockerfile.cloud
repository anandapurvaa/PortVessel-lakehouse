FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY cloud_batch_job_v3_requirements.txt requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY scripts/cloud_batch_job_parameterized.py /app/cloud_batch_job.py

CMD ["python", "/app/cloud_batch_job.py"]
