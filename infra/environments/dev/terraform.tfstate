            "source_contents": "main:\n  params: [args]\n  steps:\n    - init:\n        assign:\n          - project: ${args.project}\n          - region: ${args.region}\n          - ingestion_job: ${args.ingestion_job}\n          - loader_job: ${args.loader_job}\n          - quality_job: ${args.quality_job}\n          - cursor_dataset: ${args.cursor_dataset}\n          - cursor_table: ${args.cursor_table}\n          - pipeline_name: ${args.pipeline_name}\n          - run_id: ${string(sys.now())}\n\n    - get_cursor:\n        call: googleapis.bigquery.v2.jobs.query\n        args:\n          projectId: ${project}\n          body:\n            location: europe-west3\n            useLegacySql: false\n            parameterMode: NAMED\n            query: ${\"SELECT CAST(next_source_date AS STRING) AS source_date FROM `\" + project + \".\" + cursor_dataset + \".\" + cursor_table + \"` WHERE pipeline_name=@pipeline_name AND status='ready' LIMIT 1\"}\n            queryParameters:\n              - name: pipeline_name\n                parameterType:\n                  type: STRING\n                parameterValue:\n                  value: ${pipeline_name}\n        result: cursor_result\n\n    - validate_cursor:\n        switch:\n          - condition: ${len(cursor_result.rows) == 0}\n            next: fail_no_cursor\n        next: run_ingestion\n\n    - fail_no_cursor:\n        raise: \"No ready pipeline cursor found\"\n\n    - run_ingestion:\n        call: googleapis.run.v2.projects.locations.jobs.run\n        args:\n          name: ${\"projects/\" + project + \"/locations/\" + region + \"/jobs/\" + ingestion_job}\n          body:\n            overrides:\n              containerOverrides:\n                - env:\n                    - name: SOURCE_DATE\n                      value: ${cursor_result.rows[0].f[0].v}\n                    - name: RUN_ID\n                      value: ${run_id}\n        result: ingestion_result\n        next: run_loader\n\n    - run_loader:\n        call: googleapis.run.v2.projects.locations.jobs.run\n        args:\n          name: ${\"projects/\" + project + \"/locations/\" + region + \"/jobs/\" + loader_job}\n          body:\n            overrides:\n              containerOverrides:\n                - env:\n                    - name: SOURCE_DATE\n                      value: ${cursor_result.rows[0].f[0].v}\n                    - name: RUN_ID\n                      value: ${run_id}\n        result: loader_result\n        next: run_quality\n\n    - run_quality:\n        call: googleapis.run.v2.projects.locations.jobs.run\n        args:\n          name: ${\"projects/\" + project + \"/locations/\" + region + \"/jobs/\" + quality_job}\n          body:\n            overrides:\n              containerOverrides:\n                - env:\n                    - name: SOURCE_DATE\n                      value: ${cursor_result.rows[0].f[0].v}\n                    - name: RUN_ID\n                      value: ${run_id}\n        result: quality_result\n        next: advance_cursor\n\n    - advance_cursor:\n        call: googleapis.bigquery.v2.jobs.query\n        args:\n          projectId: ${project}\n          body:\n            location: europe-west3\n            useLegacySql: false\n            query: ${\"UPDATE `\" + project + \".\" + cursor_dataset + \".\" + cursor_table + \"` SET next_source_date=DATE_ADD(DATE('\" + cursor_result.rows[0].f[0].v + \"'), INTERVAL 1 DAY), last_run_id='\" + run_id + \"', updated_at=CURRENT_TIMESTAMP() WHERE pipeline_name='\" + pipeline_name + \"' AND next_source_date=DATE('\" + cursor_result.rows[0].f[0].v + \"') AND status='ready'\"}\n        result: cursor_update\n\n    - done:\n        return:\n          status: completed\n          source_date: ${cursor_result.rows[0].f[0].v}\n          ingestion: ${ingestion_result}\n          loader: ${loader_result}\n          quality: ${quality_result}\n          cursor_update: ${cursor_update}\n",
            "state": "ACTIVE",
            "tags": null,
            "terraform_labels": {
              "goog-terraform-provisioned": "true"
            },
            "timeouts": null,
            "update_time": "2026-08-26T06:22:25.680872252Z",
            "user_env_vars": {}
